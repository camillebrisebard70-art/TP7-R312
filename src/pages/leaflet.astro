---
import Layout from "../layouts/Layout.astro";
import "leaflet/dist/leaflet.css";
import listeEtablissements from "../assets/listeEtablissements.json";

const nbEtablissements = listeEtablissements.filter(
  (e) => e.lat && e.lon
).length;
---

<Layout>
  <h1 class="mb-1 text-3xl font-bold text-slate-900">
    Établissements en France
  </h1>
  <p class="mb-6 text-slate-600">
    {nbEtablissements} établissements localisés. Clique sur un marqueur pour
    afficher son nom, utilise la molette ou les boutons +/− pour zoomer.
  </p>

  <section class="rounded-xl bg-white p-3 shadow">
    <div
      id="map"
      role="region"
      aria-label="Carte interactive des établissements en France"
      class="h-[600px] w-full rounded-lg"
    >
    </div>
  </section>

  <p class="mt-3 text-sm text-slate-500">
    Fond de carte : OpenStreetMap contributors.
  </p>

  <script>
    import listeEtablissements from "../assets/listeEtablissements.json";
    import L from "leaflet";

    const map = L.map("map").setView([46.6033, 1.883], 6);

    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution: "&copy; OpenStreetMap contributors",
    }).addTo(map);

    listeEtablissements.forEach((etab) => {
      if (etab.lat && etab.lon) {
        L.marker([etab.lat, etab.lon])
          .addTo(map)
          .bindPopup(etab.name ?? "Établissement");
      }
    });
  </script>
</Layout>